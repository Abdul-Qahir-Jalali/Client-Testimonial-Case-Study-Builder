# ---------------------------------------------------------------
# Client Testimonial & Case Study Builder - configuration
#
# Copy this file to ".env" and fill in your own keys:
#   Windows:       copy .env.example .env
#   macOS / Linux: cp .env.example .env
#
# Never commit your real .env file (it is listed in .gitignore).
# Don't put quotes or spaces around the values.
# ---------------------------------------------------------------

# Required - writes the testimonials and case study
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional - only needed to transcribe audio, video or links
# Get a key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_MODEL=scribe_v2

# Optional - shown in the generated case study ("Delivered by ...")
AGENCY_NAME=Your Agency Name

# Optional - the "Video" tab. Animated slides need no key at all.
# The "AI-generated film" style uses free open-source models (Wan 2.2, LTX-Video) on Hugging Face.
# A free token is optional but raises the daily GPU limit: https://huggingface.co/settings/tokens
HF_TOKEN=
# Voiceover voice and speed (free text-to-speech). Voices: run edge-tts --list-voices
VIDEO_VOICE=en-US-AriaNeural
VIDEO_VOICE_RATE=+12%
